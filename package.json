{
  "name": "jev-ocu",
  "version": "0.5.0",
  "description": "Evidence-aware Jev reviewer, host-controlled Computer Use and Paint/Resolve/CapCut desktop skills",
  "private": true,
  "type": "module",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jev-ocu": "bin/jev-ocu.mjs"
  },
  "exports": {
    ".": "./src/reviewer.mjs",
    "./openrouter": "./src/openrouter.mjs",
    "./windows": "./windows/desktop.mjs",
    "./evidence": "./src/evidence.mjs",
    "./official-sky": "./src/adapters/official-sky.mjs",
    "./indexed-observation": "./src/adapters/indexed-observation.mjs"
  },
  "scripts": {
    "test": "node --test",
    "start": "node bin/jev-ocu.mjs mcp",
    "doctor": "node bin/jev-ocu.mjs doctor",
    "demo": "node bin/jev-ocu.mjs demo",
    "install-skill": "node bin/jev-ocu.mjs install",
    "windows:doctor": "node windows/cli.mjs doctor",
    "windows:mcp": "node windows/cli.mjs mcp",
    "windows:test": "node --test windows/desktop.test.mjs windows/native.test.mjs tests/enhancements.test.mjs",
    "windows:install": "node windows/install.mjs",
    "install-app-skills": "node bin/jev-ocu.mjs install-app-skills",
    "skills": "node bin/jev-ocu.mjs skills"
  },
  "pi": {
    "extensions": [
      "./integrations/pi/index.ts"
    ],
    "skills": [
      "./skill/jev-ocu"
    ]
  },
  "files": [
    "src",
    "bin",
    "integrations",
    "skill",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    ".env.example",
    "windows"
  ]
}
